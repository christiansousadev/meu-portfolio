# ============================================================
# .env.example - copie para .env e preencha com valores reais
# NUNCA commite o .env final no Git
# ============================================================

# Ambiente: "development" ou "production"
ENV=production

# JWT (gere com: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Porta exposta no host para acesso local (se 8081 estiver em uso, utilize 8085 ou outra)
FRONTEND_PORT=8085

# Origens autorizadas para CORS (separadas por virgula, SEM wildcard "*")
# em deploy same-origin o cors nao e usado pelo browser, mas preserve aqui
# para auditoria e para o caso de hospedar frontend e api em dominios distintos
ALLOWED_ORIGINS=https://christiansousa.dev,http://localhost:8085,http://localhost:8081

# Proxies reversos confiaveis (CIDR ou IPs)
# inclui: loopback do host + redes docker internas (Nginx e Cloudflare Tunnel)
TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ------------------------------------------------------------
# Cloudflare Tunnel (Conexao segura sem expor portas na internet)
# ------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------
# Cloudflare Turnstile (Protecao contra bots no login administrativo)
# ------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------
# Provedor LLM ativo: json_only | gemini | openai | ollama | deepseek
# ------------------------------------------------------------
ACTIVE_INTERPRETER=json_only

GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_URL=http://localhost:11434/api/generate

# ------------------------------------------------------------
# Credenciais administrativas
# ADMIN_PASSWORD_HASH = hash bcrypt da senha (NUNCA a senha em texto)
# Gere com: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('SUA_SENHA'))"
# Tambem aceita ADMIN_PASSWORD em desenvolvimento como fallback.
# ------------------------------------------------------------
ADMIN_USER=admin@christiansousa.dev
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
